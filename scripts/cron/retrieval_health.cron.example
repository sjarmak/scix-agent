# Install only after the branch lands, with SCIX_PROJECT_ROOT set in the crontab.
# The probe exits after one query and holds no resources between runs.
20 * * * * cd "$SCIX_PROJECT_ROOT" && set -a && . ./.env && set +a && SCIX_BATCH=${SCIX_BATCH:-scix-batch} && "$SCIX_BATCH" .venv/bin/python scripts/check_retrieval_health.py --allow-prod --notify >> logs/retrieval_health.log 2>&1
